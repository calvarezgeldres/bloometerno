# Credenciales de Neon (PostgreSQL) para desarrollo local
# Obtén esta URL en: https://console.neon.tech/
# → Tu proyecto → Connection Details → Connection string
# IMPORTANTE: Esta variable es privada (solo servidor). NUNCA uses VITE_ aquí.
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require

# Clave secreta para firmar la cookie de sesión del panel /admin.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: Esta variable es privada (solo servidor). NUNCA uses VITE_ aquí.
SESSION_SECRET=
