# Credenciales de Neon (PostgreSQL) para desarrollo local
# Obtén esta URL en: https://console.neon.tech/
# → Tu proyecto → Connection Details → Connection string
# IMPORTANTE: Esta variable es privada (solo servidor). NUNCA uses VITE_ aquí.
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require

# Clave secreta para firmar la cookie de sesión del panel /admin.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: Esta variable es privada (solo servidor). NUNCA uses VITE_ aquí.
SESSION_SECRET=

# Mercado Pago (Checkout Pro) — credenciales de tu cuenta en developers.mercadopago.com
# IMPORTANTE: el access token es privado (solo servidor). NUNCA uses VITE_ aquí.
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-de-mercadopago

# La public key sí se expone al navegador (checkout de Mercado Pago), por eso lleva VITE_.
VITE_MERCADOPAGO_PUBLIC_KEY=tu-public-key-de-mercadopago

# Dominio público del sitio (para las back_urls y el webhook de Mercado Pago).
# En Vercel, si no se define, se usa VERCEL_URL como respaldo.
SITE_URL=https://tu-dominio.cl
